{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "ng: serve tests",
      "pathMapping": {
        "/": "${workspaceFolder}/client/",
        "/base/": "${workspaceFolder}/client/"
      }
    },
    {
      "name": "ng test (headless)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/client/node_modules/@angular/cli/bin/ng",
      "args": ["test", "--watch=false", "--code-coverage"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
